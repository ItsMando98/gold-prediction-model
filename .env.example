# Copy to .env and fill in before running the stack.

# --- Database ---
DATABASE_URL=postgresql+psycopg://gold:gold@localhost:5432/gold_prediction
POSTGRES_USER=gold
POSTGRES_PASSWORD=gold
POSTGRES_DB=gold_prediction

# --- Cache / broker ---
REDIS_URL=redis://localhost:6379/0

# --- Providers ---
# FRED (https://fred.stlouisfed.org/docs/api/api_key.html) - required for rates ingestion.
FRED_API_KEY=

# --- AI Agent Team (plan section 50) ---
# Anthropic API key - required for the News Event Agent and Explanation Agent.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development
